#!/usr/bin/env bash
set -euo pipefail

container="${SRAM_EDA_CONTAINER:-sram-xschem}"
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"

if ! command -v docker >/dev/null 2>&1; then
    printf 'Erro: Docker não está disponível no PATH do host.\n' >&2
    exit 127
fi

if ! docker inspect "$container" >/dev/null 2>&1; then
    printf 'Erro: o container %s não existe. Consulte tools/ENVIRONMENT.md.\n' "$container" >&2
    exit 1
fi

# The Xauthority cookie created by Mutter has a session-specific filename.
# The container stores the bind-mount source chosen when it was created, so
# refresh that host-side file from this session before launching a GUI tool.
# Docker may have created an empty directory at a missing bind source; remove
# it only when empty, then install the current cookie with owner-only access.
case "${1:-}" in
    xschem|magic|gtkwave)
        xauth_source="$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/tmp/xauth"}}{{.Source}}{{end}}{{end}}' "$container")"
        if [[ -n "$xauth_source" ]]; then
            if [[ -z "${XAUTHORITY:-}" || ! -f "$XAUTHORITY" ]]; then
                printf 'Erro: ferramenta gráfica solicitada, mas XAUTHORITY não aponta para um arquivo válido.\n' >&2
                exit 1
            fi
            if [[ -d "$xauth_source" && ! -L "$xauth_source" ]]; then
                if ! rmdir -- "$xauth_source"; then
                    printf 'Erro: origem do Xauthority é um diretório não vazio: %s\n' "$xauth_source" >&2
                    exit 1
                fi
            fi
            if [[ -f "$xauth_source" ]]; then
                if [[ "$(realpath -e -- "$xauth_source")" != "$(realpath -e -- "$XAUTHORITY")" ]]; then
                    if ! chmod 600 -- "$xauth_source" || ! cat -- "$XAUTHORITY" > "$xauth_source"; then
                        printf 'Erro: não foi possível atualizar o Xauthority montado no container.\n' >&2
                        exit 1
                    fi
                fi
            elif [[ ! -e "$xauth_source" ]]; then
                if ! install -m 600 -- "$XAUTHORITY" "$xauth_source"; then
                    printf 'Erro: não foi possível criar o Xauthority montado no container.\n' >&2
                    exit 1
                fi
            else
                printf 'Erro: tipo inesperado para a origem do Xauthority: %s\n' "$xauth_source" >&2
                exit 1
            fi
        fi
        ;;
esac

mounted_repo="$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/work"}}{{.Source}}{{end}}{{end}}' "$container")"
if [[ -z "$mounted_repo" || "$(realpath -- "$mounted_repo")" != "$repo_root" ]]; then
    printf 'Erro: o container %s não monta este checkout em /work.\n' "$container" >&2
    printf 'Checkout: %s\nMontagem: %s\n' "$repo_root" "${mounted_repo:-ausente}" >&2
    exit 1
fi

state="$(docker inspect --format '{{.State.Running}}' "$container")"
if [[ "$state" != true ]]; then
    printf 'Iniciando container %s...\n' "$container" >&2
    docker start "$container" >/dev/null
fi

read -r -d '' container_setup <<'REMOTE' || true
set -eu

# These tools are installed in versioned /opt directories in the project image,
# but the image PATH omits those directories. Discover them at runtime so the
# launcher also survives a tool version directory change.
for tool_dir in \
    /opt/ngspice/*/bin \
    /opt/magic/*/bin \
    /opt/netgen/*/bin \
    /opt/iverilog/*/bin \
    /opt/xschem/*/bin; do
    if [ -d "$tool_dir" ]; then
        PATH="$tool_dir:$PATH"
    fi
done
export PATH
export PDK_ROOT=/opt/pdks
export PDK=sky130A

case "${1:-}" in
    __shell)
        exec bash -i
        ;;
    --check)
        failed=0
        printf 'Container: %s\nPDK: %s (%s)\n' "$HOSTNAME" "$PDK" "$PDK_ROOT/$PDK"

        for tool in xschem ngspice magic netgen iverilog vvp gtkwave python3 git; do
            if tool_path="$(command -v "$tool" 2>/dev/null)"; then
                printf '%-10s %s\n' "$tool" "$tool_path"
            else
                printf '%-10s AUSENTE\n' "$tool"
                failed=1
            fi
        done

        for pdk_file in \
            "$PDK_ROOT/$PDK/libs.tech/combined/continuous/sky130.lib.spice" \
            "$PDK_ROOT/$PDK/libs.tech/magic/sky130A.magicrc" \
            "$PDK_ROOT/$PDK/libs.tech/netgen/setup.tcl" \
            "$PDK_ROOT/$PDK/libs.tech/xschem/xschemrc"; do
            if [ -r "$pdk_file" ]; then
                printf 'PDK file OK: %s\n' "$pdk_file"
            else
                printf 'PDK file AUSENTE: %s\n' "$pdk_file"
                failed=1
            fi
        done

        xschem --version 2>&1 | sed -n '1p'
        ngspice --version 2>&1 | sed -n '2p'
        iverilog -V 2>&1 | sed -n '1p'
        python3 -c 'import gdstk, matplotlib, numpy; print("Python modules: gdstk", gdstk.__version__, "matplotlib", matplotlib.__version__, "numpy", numpy.__version__)' || failed=1

        if [ "$failed" -ne 0 ]; then
            exit 1
        fi
        printf 'Ambiente pronto.\n'
        ;;
    *)
        if [ "$#" -eq 0 ]; then
            printf 'Use: sram-eda --check | sram-eda <comando> [argumentos...]\n' >&2
            exit 2
        fi
        exec "$@"
        ;;
esac
REMOTE

if [[ $# -eq 0 ]]; then
    set -- __shell
fi

if [[ "${1:-}" == "__shell" ]]; then
    exec docker exec -it -w /work "$container" sh -lc "$container_setup" sram-eda "$@"
fi

exec docker exec -i -w /work "$container" sh -lc "$container_setup" sram-eda "$@"
