v {xschem version=3.4.6 file_version=1.2}
K {type=subcircuit
format="@name @pinlist @symname"
template="name=x1"
}
T {pclk_phase_source} -55 -6 0 0 0.3 0.3 {}
T {@name} 110 -45 0 0 0.2 0.2 {}
P 4 5 -100 -50 -100 50 100 50 100 -50 -100 -50 {}
B 5 -2.5 -62.5 2.5 -57.5 {name=VDD dir=inout}
L 7 0 -60 0 -50 {}
T {VDD} 5 -56 0 0 0.2 0.2 {}
B 5 -122.5 -42.5 -117.5 -37.5 {name=CLK dir=in}
L 4 -120 -40 -100 -40 {}
T {CLK} -95 -44 0 0 0.2 0.2 {}
B 5 -2.5 -22.5 2.5 -17.5 {name=VSS dir=inout}
L 7 0 -20 0 -10 {}
T {VSS} 5 -16 0 0 0.2 0.2 {}
B 5 -122.5 -2.5 -117.5 2.5 {name=VALID_ACCESS_Q dir=in}
L 4 -120 0 -100 0 {}
T {VALID_ACCESS_Q} -95 -4 0 0 0.2 0.2 {}
B 5 117.5 17.5 122.5 22.5 {name=PCLK dir=out}
L 4 100 20 120 20 {}
T {PCLK} 95 16 0 1 0.2 0.2 {}
B 5 117.5 37.5 122.5 42.5 {name=PRECH dir=out}
L 4 100 40 120 40 {}
T {PRECH} 95 36 0 1 0.2 0.2 {}
