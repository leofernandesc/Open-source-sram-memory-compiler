* New 2x2 extracted abutment: external drivers only; no internal initialization
.lib "/opt/pdks/sky130A/libs.tech/ngspice/sky130.lib.spice" tt
.include "binding.spice"
.temp 27
.options method=gear klu
.model WSW SW(Ron=50 Roff=1e12 Vt=.9 Vh=.1)
.model PSW SW(Ron=100 Roff=1e12 Vt=.9 Vh=.1)
