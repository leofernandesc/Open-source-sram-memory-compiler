.control
set num_threads=1
set wr_singlescale
set wr_vecnames
tran 10p 250n 0 10p
wrdata waveform.dat v(VDD) v(WL0) v(WL1) v(BL0) v(BLB0) v(BL1) v(BLB1) v(xdut.n6) v(xdut.n5) v(xdut.n2) v(xdut.n1) v(xdut.n7) v(xdut.n4) v(xdut.n3) v(xdut.n0)
