** sch_path: /work/cells/write_driver.sch
**.subckt write_driver DATA DATA_B WE BL BLB VDD VSS
*.iopin DATA
*.iopin DATA_B
*.iopin WE
*.iopin BL
*.iopin BLB
*.iopin VDD
*.iopin VSS
XMPWEB WE_B WE VDD VDD sky130_fd_pr__pfet_01v8 L=0.15 W=0.84 nf=1 ad='int((nf+1)/2) * W/nf * 0.29' as='int((nf+2)/2) * W/nf * 0.29'
+ pd='2*int((nf+1)/2) * (W/nf + 0.29)' ps='2*int((nf+2)/2) * (W/nf + 0.29)' nrd='0.29 / W' nrs='0.29 / W' sa=0 sb=0 sd=0 mult=1 m=1
